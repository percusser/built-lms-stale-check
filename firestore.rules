rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'tyler@builtlms.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    function validNewFlag(d) {
      return d.keys().hasOnly(['factId', 'moduleId', 'courseId', 'verdict', 'oldValue', 'newValue', 'quote', 'origin', 'inferenceSource', 'createdAt', 'createdBy', 'changedAt', 'sourceUrl', 'sourceLabel', 'status'])
        && d.keys().hasAll(['factId', 'moduleId', 'verdict', 'oldValue', 'newValue', 'quote', 'origin', 'inferenceSource', 'createdAt', 'status'])
        && shortString(d.factId, 120)
        && shortString(d.moduleId, 80)
        && (!('courseId' in d) || shortString(d.courseId, 80))
        && d.verdict in ['changed', 'removed']
        && shortString(d.oldValue, 500)
        && shortString(d.newValue, 500)
        && shortString(d.quote, 1000)
        && d.origin in ['extension', 'iphone']
        && d.inferenceSource in ['ON_DEVICE', 'IN_CLOUD', 'IN_CLOUD_AFTER_REFUSAL']
        && d.createdAt is int
        && (!('createdBy' in d) || shortString(d.createdBy, 120))
        && (!('changedAt' in d) || d.changedAt is int)
        && (!('sourceUrl' in d) || (shortString(d.sourceUrl, 2000) && d.sourceUrl.matches('^https?://.*')))
        && (!('sourceLabel' in d) || shortString(d.sourceLabel, 200))
        && d.status == 'open';
    }

    function validFix(fix) {
      return fix is map
        && fix.keys().hasOnly(['changeSummary', 'blocks', 'quizQuestions'])
        && shortString(fix.changeSummary, 2000)
        && fix.blocks is list && fix.blocks.size() <= 20
        && fix.quizQuestions is list && fix.quizQuestions.size() <= 20;
    }

    function validUpdate(before, after) {
      return before.status != 'fixed'
        && after.diff(before).affectedKeys().hasOnly(['status', 'approvedAt', 'approvedBy', 'correctionNotice', 'noticeRecipients', 'fix'])
        && (!('approvedBy' in after) || after.approvedBy == request.auth.token.email)
        && after.status in ['open', 'approved', 'dismissed']
        && (!('approvedAt' in after) || after.approvedAt is int)
        && (!('correctionNotice' in after) || shortString(after.correctionNotice, 4000))
        && (!('noticeRecipients' in after) || (after.noticeRecipients is list && after.noticeRecipients.size() <= 500))
        && (!('fix' in after) || validFix(after.fix))
        && (after.status != 'approved' || ('fix' in after && validFix(after.fix)));
    }

    match /flags/{flagId} {
      allow get: if resource == null || isAdmin();
      allow list: if isAdmin();
      allow create: if flagId.size() <= 200 && validNewFlag(request.resource.data);
      allow update: if isAdmin() && validUpdate(resource.data, request.resource.data);
      allow delete: if false;
    }

    match /completions/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /learners/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /demo/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    match /meta/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
