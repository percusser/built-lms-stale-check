{
  "manifest_version": 3,
  "name": "Built LMS Stale Training Check",
  "version": "0.1.0",
  "description": "Spots when a page your training was built from changes, and flags the lessons that are now wrong.",
  "key": "",
  "minimum_chrome_version": "138",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5050/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Check this page against your training"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5050/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
